<div class="auth-shell">
    <header class="auth-header">
        <a class="brand" href="/" aria-label="LOADOUT home"><span class="brand-mark" aria-hidden="true"></span>LOADOUT</a>
        <a class="auth-back" href="/"><span aria-hidden="true">←</span> Back to home</a>
    </header>
    <main id="main-content" class="auth-main">
        <section class="auth-form-panel" aria-labelledby="auth-title">
            <div class="auth-form-wrap">
                <span class="eyebrow">A good place to pick up</span>
                <h1 id="auth-title">@Title</h1>
                <p class="auth-description">@Description</p>
                @ChildContent
                <p class="auth-alternate">@AlternatePrompt <a href="@AlternateHref">@AlternateLabel <span aria-hidden="true">→</span></a></p>
                <div class="auth-demo"><span>Just looking around?</span><DemoEntry /></div>
                <p class="auth-temporary">Midterm demo: accounts and games are temporary and reset when the app restarts.</p>
            </div>
        </section>
        <aside class="auth-art" aria-label="A preview of your three-game rotation">
            <img class="auth-art-cover" src="/images/call-of-duty.png" alt="" />
            <div class="auth-art-heading"><span class="eyebrow">Less to choose. More to enjoy.</span><h2>Your next chapter<br />starts with one game.</h2></div>
            <div class="auth-art-bottom">
                <div class="auth-art-caption"><span class="auth-art-line"></span><span>A little focus goes a long way.</span></div>
                <div class="auth-game-strip" aria-label="Example games">
                    @foreach (var game in SampleGames.Catalog()) { <img src="@game.Cover" alt="@game.Title" title="@game.Title" /> }
                </div>
                <div class="auth-mini-slots"><span><b>01</b> Main campaign</span><span><b>02</b> Quick play</span><span><b>03</b> Co-op / endless</span></div>
                <p>Three active games. A recommendation for the time you have.</p>
            </div>
        </aside>
    </main>
</div>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string AlternatePrompt { get; set; } = "";
    [Parameter] public string AlternateHref { get; set; } = "";
    [Parameter] public string AlternateLabel { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
