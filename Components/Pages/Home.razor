@page "/"
@rendermode InteractiveServer
@layout EmptyLayout
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>LOADOUT | Backlog Elimination Protocol</PageTitle>

<div class="loadout-landing" data-loadout-page data-interactive="@(interactive ? "true" : "false")">
    <nav data-loadout-nav class="loadout-nav" aria-label="Primary navigation">
        <a class="loadout-nav__brand" href="#hero-tactical" aria-label="LOADOUT home"><span class="loadout-nav__signal" aria-hidden="true"></span><span>LOADOUT</span></a>
        <div class="loadout-nav__links">
            <a href="#how-it-works">How it works</a>
            <a href="#telemetry-showcase-pin">Mechanics</a>
            <a href="#live-hud">The loadout</a>
            <a href="#roulette-engine">Tonight's pick</a>
            <a href="#the-games">The games</a>
            <a href="#rules-engagement">The rules</a>
        </div>
        <div class="loadout-nav__actions">
            <a class="loadout-nav__login" href="/login">Log in</a>
            <a class="button button--compact" href="/register">Create account</a>
            <button class="loadout-nav__menu-button" type="button" aria-expanded="@(menuOpen ? "true" : "false")" aria-controls="landing-menu" @onclick="() => menuOpen = !menuOpen">@(menuOpen ? "Close" : "Menu")</button>
        </div>
        @if (menuOpen)
        {
            <div id="landing-menu" class="loadout-menu">
                <div class="loadout-menu__links">
                    <a href="#how-it-works" @onclick="CloseMenu">How it works</a>
                    <a href="#live-hud" @onclick="CloseMenu">The loadout</a>
                    <a href="#roulette-engine" @onclick="CloseMenu">Tonight's pick</a>
                    <a href="#the-games" @onclick="CloseMenu">The games</a>
                    <a href="#rules-engagement" @onclick="CloseMenu">The rules</a>
                </div>
                <div class="loadout-menu__account"><a href="/login">Log in</a><a href="/register">Create account</a></div>
            </div>
        }
    </nav>

    <main id="main-content">
        <section id="hero-tactical" class="hero section-anchor">
            <div class="hero__word-clip" aria-hidden="true"><div class="hero__word" data-hero-word>LOADOUT</div></div>
            <div class="hero__grid">
                <div class="hero__message">
                    <div class="reveal-clip"><h1 data-hero-title><span>Backlog </span><span>Elimination Protocol.</span></h1></div>
                    <div class="hero__copy" data-hero-copy><p>Lock three active titles into a focused rotation. Spend less time choosing and more time playing what you start.</p><a class="button" href="/register">Build your 3 slots</a></div>
                    <div class="hero__demo"><DemoEntry /></div>
                </div>
                <div class="hero__interface" data-hero-ui aria-label="Example active game loadout">
                    <div class="hero__interface-head"><span>Active loadout</span><span>3 slots · sample data</span></div>
                    @for (var i = 0; i < samples.Length; i++)
                    {
                        var game = samples[i];
                        <article class="hero-slot @(i == 0 ? "hero-slot--active" : "")">
                            <img src="@game.Cover" alt="@game.AltText" />
                            <div><span>@game.Role</span><strong>@game.Title</strong><small>@game.PrimaryValue · @game.SecondaryValue</small></div>
                            <b>@(game.Status == GameStatus.Cleared ? "Completed" : "Active")</b>
                        </article>
                    }
                    <p class="hero__sample-note">Your own account starts empty. Choose the games that belong in your rotation.</p>
                </div>
            </div>
            <a class="hero__scroll" href="#how-it-works">See how your loadout comes together ↓</a>
        </section>

        <section id="how-it-works" data-reveal-section class="story section-anchor section-dark">
            <div class="story__grid page-frame">
                <header class="story__heading"><h2 data-reveal-title>Too Many Choices.<br />Three Clear Slots.</h2><p data-reveal-copy>Give every active game a role. Keep the rest out of tonight's decision.</p></header>
                <div class="story__steps">
                    <article class="story-step" data-story-step>
                        <div data-reveal-media class="story-step__visual story-step__visual--backlog"><span class="story-step__number" aria-hidden="true">∞</span><img src="/images/call-of-duty.png" alt="Call of Duty" /><img src="/images/roblox.png" alt="Roblox" /><img src="/images/peak.png" alt="PEAK" /></div>
                        <div class="story-step__copy" data-story-copy><h3>Remove the wall of choices.</h3><p>Your full collection doesn't need to compete for attention every night. Start with the three games you want to keep playing.</p></div>
                    </article>
                    <article class="story-step" data-story-step>
                        <div data-reveal-media class="story-step__visual story-step__visual--roles">@foreach (var game in samples) { <figure><img src="@game.Cover" alt="@game.AltText" /><figcaption>@game.Role</figcaption></figure> }</div>
                        <div class="story-step__copy" data-story-copy><h3>Give every slot a job.</h3><p>One main campaign for focused sessions, one quick-play game for a short break, and one co-op or endless game for another round.</p></div>
                    </article>
                    <article class="story-step" data-story-step>
                        <div data-reveal-media class="story-step__visual story-step__visual--decision"><img src="/images/rv-there-yet.png" alt="RV There Yet? road-trip game" /><strong>One clear next move.</strong></div>
                        <div class="story-step__copy" data-story-copy><h3>Play before you browse.</h3><p>Set your available time and energy. LOADOUT recommends from the games already in your rotation.</p></div>
                    </article>
                </div>
            </div>
        </section>

        <section id="telemetry-showcase-pin" data-reveal-section class="mechanics section-anchor section-light">
            <div class="page-frame">
                <header class="section-heading mechanics__heading"><h2 data-reveal-title>The 3 Core Mechanics</h2></header>
                <div class="mechanics__columns" data-reveal-media>
                    <article><h3>The 3-Slot Lock</h3><p>A fourth game waits until you complete or deliberately drop one of your active games.</p><strong>A smaller rotation. More focus.</strong></article>
                    <article><h3>A Pick for Tonight</h3><p>Your available minutes and energy help choose a game that fits the session you actually have.</p><strong>Your time sets the pace.</strong></article>
                    <article><h3>Your Game History</h3><p>Keep a record of completed and dropped games, with your notes and completion rewards.</p><strong>Every ending makes room.</strong></article>
                </div>
                <div class="mechanics__statement"><span>Limit the choices.</span><span>Match the moment.</span><span>Enjoy the game.</span></div>
            </div>
        </section>

        <section id="live-hud" data-reveal-section class="live-hud section-anchor section-dark">
            <div class="page-frame">
                <header class="section-heading section-heading--split"><h2 data-reveal-title>Your Active 3-Slot Loadout</h2><p data-reveal-copy>Select a game to inspect its role and example progress. This preview is separate from your account.</p></header>
                <div class="terminal" data-reveal-media>
                    <div class="terminal__tabs" role="group" aria-label="Preview slots">
                        @for (var i = 0; i < samples.Length; i++)
                        {
                            var index = i; var game = samples[i];
                            <button type="button" aria-pressed="@(activeSlot == i)" class="@(activeSlot == i ? "is-active" : "")" @onclick="() => activeSlot = index"><span>@game.Role</span><strong>@game.Title</strong></button>
                        }
                    </div>
                    <div class="terminal__toolbar"><span>@SelectedGame.Role</span><span class="terminal__preview-note">Sample progress · try the full demo to save changes</span></div>
                    <div class="terminal__body">
                        <figure class="terminal__cover"><img src="@SelectedGame.Cover" alt="@SelectedGame.AltText" /></figure>
                        <div class="terminal__details">
                            <div class="terminal__title-row"><div><span>Selected game</span><h3>@SelectedGame.Title</h3></div><b class="status @(SelectedGame.Status == GameStatus.Cleared ? "status--cleared" : "")">@(SelectedGame.Status == GameStatus.Cleared ? "Completed" : "Active")</b></div>
                            <dl class="terminal__metrics"><div><dt>@SelectedGame.PrimaryLabel</dt><dd>@SelectedGame.PrimaryValue</dd></div><div><dt>@SelectedGame.SecondaryLabel</dt><dd>@SelectedGame.SecondaryValue</dd></div><div><dt>Typical session</dt><dd>@SelectedGame.TargetSessionMinutes minutes</dd></div></dl>
                            <p>@SelectedGame.Purpose</p>
                            <div class="terminal__actions"><button type="button" class="terminal__primary" @onclick="ToggleCompleted">@(SelectedGame.Status == GameStatus.Cleared ? "Reopen sample slot" : "Try marking completed")</button><DemoEntry CssClass="button" Label="Open sample dashboard" /></div>
                            <p class="hero__sample-note">Completing or dropping a game opens its slot. Your real progress lives in the dashboard.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="roulette-engine" data-reveal-section class="roulette section-anchor">
            <div class="page-frame">
                <header class="section-heading section-heading--split"><h2 data-reveal-title>Session-Time &amp; Energy Roulette</h2><p data-reveal-copy>Tell LOADOUT how much time and energy you have. It recommends one of your active games using the same rules as the dashboard.</p></header>
                <div class="roulette__grid" data-reveal-media>
                    <div class="roulette__controls">
                        <div class="roulette__time"><label for="session-time">Available time</label><output for="session-time">@sessionMinutes <span>minutes</span></output><input id="session-time" type="range" min="15" max="180" step="15" @bind="sessionMinutes" @bind:event="oninput" aria-valuetext="@SessionPicker.TimeLabel(sessionMinutes)" /><div class="roulette__range-labels" aria-hidden="true"><span>Quick</span><span>Normal</span><span>Deep</span></div></div>
                        <fieldset class="roulette__battery"><legend>Energy</legend><div>@foreach (var value in new[] { 20, 50, 80, 100 }) { <button type="button" aria-pressed="@(energy == value)" class="@(energy == value ? "is-active" : "")" @onclick="() => energy = value">@value% @SessionPicker.EnergyLabel(value).ToLowerInvariant()</button> }</div></fieldset>
                    </div>
                    <aside class="roulette__result" data-recommendation aria-live="polite" aria-atomic="true"><span>Your next session · sample data</span>@if (Recommendation.Game is { } pickedGame) { <img class="roulette__game-cover" src="@pickedGame.Cover" alt="@pickedGame.AltText" /><h3>@pickedGame.Role</h3><strong>@pickedGame.Title</strong><p>@Recommendation.Reason</p> } else { <h3>All slots completed.</h3><p>Reopen a sample slot above or build your own loadout.</p> }<div class="roulette__result-foot"><span>@sessionMinutes minutes · @SessionPicker.EnergyLabel(energy).ToLowerInvariant() energy</span><a href="/register">Build this loadout</a></div></aside>
                </div>
            </div>
        </section>

        <section id="the-games" data-reveal-section class="diagnostics section-anchor section-light">
            <div class="page-frame">
                <header class="section-heading section-heading--split"><h2 data-reveal-title>Your Games. Your Rotation.</h2><p data-reveal-copy>Five familiar games to try in the sample loadout. Still just three active slots at a time. All progress shown is example data.</p></header>
                <div class="game-gallery" data-reveal-media>@foreach (var game in SampleGames.Catalog()) { <figure class="gallery-game"><div class="gallery-game__art"><img src="@game.Cover" alt="@game.AltText" loading="lazy" /></div><figcaption><strong>@game.Title</strong><span>@game.Role</span></figcaption></figure> }</div>
            </div>
        </section>

        <section id="rules-engagement" data-reveal-section class="rules section-anchor section-dark">
            <div class="page-frame rules__grid">
                <header class="rules__heading"><span aria-hidden="true">RULES</span><h2 data-reveal-title>The Rules of Engagement</h2><p data-reveal-copy>Simple limits that keep the next session clear.</p></header>
                <div class="rules__list" data-reveal-media>
                    <details open><summary>Three active games <span>Focus</span></summary><div><p>Keep one game in each role. You can start with just one; you don't need to fill all three slots.</p><strong>No fourth slot competing for tonight.</strong></div></details>
                    <details><summary>Match your session <span>Fit</span></summary><div><p>Set the time and energy you have. The recommendation helps you choose, and you decide what to play.</p><strong>Your choice stays until you change it.</strong></div></details>
                    <details><summary>Complete it or move on <span>Closure</span></summary><div><p>Mark a game completed or deliberately drop it before replacing it. Either action saves it to History and opens the slot.</p><strong>Completed games earn 500 XP. Dropping has no penalty.</strong></div></details>
                </div>
            </div>
        </section>

        <section class="final-cta" data-reveal-section aria-labelledby="closing-title">
            <div class="page-frame final-cta__inner">
                <div class="final-cta__heading"><span class="eyebrow">Ready when you are</span><h2 id="closing-title" data-reveal-title>Take Back<br />Your Game Night.</h2></div>
                <div class="final-cta__bottom" data-reveal-copy><p>Three games. A session that fits.<br />Start building your own rotation.</p><a class="button" href="/register">Create your loadout <span aria-hidden="true">↗</span></a></div>
            </div>
        </section>
    </main>
    <footer class="loadout-footer"><div class="page-frame loadout-footer__inner"><div class="loadout-footer__columns"><div><strong>LOADOUT</strong><span>A little focus goes a long way.</span></div><div><strong>Your rotation</strong><a href="#how-it-works">How it works</a><a href="#the-games">The games</a></div><div><strong>Your account</strong><a href="/login">Log in</a><a href="/register">Create account</a></div><div><strong>Midterm project</strong><span>Temporary demo data</span><span>© 2026 LOADOUT</span></div></div></div></footer>
</div>

@code {
    private readonly GameItem[] samples = SampleGames.Create();
    private bool interactive, menuOpen, motionStarted;
    private int activeSlot, sessionMinutes = 45, energy = 35;
    private GameItem SelectedGame => samples[activeSlot];
    private RouletteResult Recommendation => RecommendationEvaluator.Evaluate(samples, sessionMinutes, energy);
    private void CloseMenu() => menuOpen = false;
    private void ToggleCompleted() => SelectedGame.Status = SelectedGame.Status == GameStatus.Active ? GameStatus.Cleared : GameStatus.Active;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("loadoutEngine.init"); motionStarted = true; }
        catch (JSException) { /* Content stays visible if the motion runtime cannot load. */ }
        interactive = true;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (!motionStarted) return;
        try { await JS.InvokeVoidAsync("loadoutEngine.cleanup"); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
}
