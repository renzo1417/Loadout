@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@layout EmptyLayout
@inject ILoadoutService Loadout
@inject IAuthService Auth
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(IsHistory ? "History" : "Tonight") · LOADOUT</PageTitle>
@if (ready && Auth.IsAuthenticated)
{
<div class="dashboard" data-interactive="@(interactive ? "true" : "false")">
    <header class="app-header"><div class="app-header-inner">
        <a class="brand" href="/dashboard" aria-label="LOADOUT Tonight"><span class="brand-mark" aria-hidden="true"></span>LOADOUT</a>
        <nav class="app-tabs" aria-label="Dashboard"><a href="/dashboard" class="@(!IsHistory ? "active" : "")" aria-current="@(!IsHistory ? "page" : null)">Tonight</a><a href="/dashboard?view=history" class="@(IsHistory ? "active" : "")" aria-current="@(IsHistory ? "page" : null)">History</a></nav>
        <div class="app-account"><button class="profile-button" @onclick="() => Open(DialogKind.Profile)"><span class="avatar">@Initial</span><span class="profile-label">@Auth.CurrentUser.DisplayName <small>Profile</small></span></button><form method="post" action="/auth/logout" data-enhance="false"><AntiforgeryToken /><button class="logout-button" data-pending="Leaving…">Log out</button></form></div>
    </div></header>
    <main id="main-content" class="app-main">
        @if (Auth.Account.IsDemo) { <div class="sample-banner"><span><b>Sample demo</b> <span class="sample-banner-detail">Try the full flow. These games belong only to this demo session.</span></span><a href="/register">Create your account <span aria-hidden="true">→</span></a></div> }
        <header class="dashboard-heading"><div><span class="eyebrow">@(IsHistory ? "Look how far you've come" : "Your time. Well played.")</span><h1>@(IsHistory ? "Your game history" : "Good to see you, " + Auth.CurrentUser.DisplayName + ".")</h1><p>@(IsHistory ? "The games you finished, and the ones you chose to leave behind." : "A smaller rotation. A clearer choice for tonight.")</p></div><span class="slot-count"><b>@ActiveCount</b> / 3 active slots</span></header>
        <div class="feedback" role="status" aria-live="polite">@feedback</div>
        @if (IsHistory)
        {
            <div class="history-toolbar"><div class="history-filters" role="group" aria-label="Filter game history">@foreach (var value in new[] { "All", "Completed", "Dropped" }) { <button class="@(historyFilter == value ? "selected" : "")" aria-pressed="@(historyFilter == value)" @onclick="() => historyFilter = value">@value <span>@HistoryCount(value)</span></button> }</div><a class="text-button" href="/dashboard">Back to Tonight <span aria-hidden="true">↗</span></a></div>
            @if (!History.Any()) { <section class="history-empty"><span class="empty-symbol" aria-hidden="true">✓</span><h2>@(historyFilter == "All" ? "Your next finish starts here." : "No " + historyFilter.ToLowerInvariant() + " games yet.")</h2><p>Completed and dropped games will appear here, along with your notes.</p><a class="button button--secondary" href="/dashboard">Back to Tonight</a></section> }
            else { <div class="history-list">@foreach (var game in History) { <article class="history-row" @key="game.Id"><GameCover Source="@game.Cover" Alt="@game.AltText" /><div class="history-copy"><span class="eyebrow">@game.Role</span><h2>@game.Title</h2>@if (!string.IsNullOrWhiteSpace(game.ClearedNotes ?? game.DroppedReason)) { <p>@(game.ClearedNotes ?? game.DroppedReason)</p> }</div><div class="history-outcome"><span class="@(game.Status == GameStatus.Cleared ? "completed-text" : "muted")">@(game.Status == GameStatus.Cleared ? "✓ Completed" : "— Dropped")</span><time datetime="@game.DateCompleted?.ToString("O")">@game.DateCompleted?.AddHours(8).ToString("MMM d, yyyy")</time>@if (game.Status == GameStatus.Cleared) { <small>+500 XP</small> }</div></article> }</div> }
        }
        else
        {
            @if (ActiveCount == 0)
            {
                <section class="first-game"><div><span class="eyebrow">A fresh start</span><h2>Add your first game.</h2><p>Start with a story, a quick break, or your regular co-op game. You don't need to fill every slot.</p><button class="button" @onclick="() => Open(DialogKind.Add, 0)">Add a main campaign <span aria-hidden="true">+</span></button></div><div class="first-game-art" aria-hidden="true"><span>01</span><span>02</span><span>03</span><b>Make room for<br />what you'll play.</b></div></section>
            }
            else
            {
                <SessionPicker Games="@Slots" Minutes="@Loadout.TimeAvailable" MinutesChanged="v => Run(() => Loadout.TimeAvailable = v)" Energy="@Loadout.BrainBattery" EnergyChanged="v => Run(() => Loadout.BrainBattery = v)" ChosenIndex="@Loadout.ChosenSlotIndex" OnChoose="Choose" />
                @if (ChosenGame != null) { <p class="chosen-note"><span aria-hidden="true">✓</span> Chosen tonight: <b>@ChosenGame.Title</b><span> Your choice stays until you change it.</span></p> }
            }
            <section class="active-section" aria-labelledby="active-title"><header class="section-top"><div><span class="eyebrow">Keep your focus</span><h2 id="active-title" tabindex="-1" data-focus-after-dialog>Your active loadout</h2></div><span class="muted">Three roles. Room to enjoy each one.</span></header>
            <div class="loadout-rack">
                @for (var i = 0; i < 3; i++)
                {
                    var index = i; var role = (SlotType)(i + 1); var game = Slots[i];
                    <article class="game-slot @(game == null ? "game-slot--empty" : "")" @key="index">
                        <div class="slot-role"><span>0@(i + 1)</span><h3>@role.ToDisplayName()</h3></div>
                        @if (game == null) { <button class="empty-slot-button" @onclick="() => Open(DialogKind.Add, index)" aria-label="Add game to @role.ToDisplayName()"><span class="empty-slot-plus" aria-hidden="true">+</span><strong>Add a game</strong><span>@role.ToSubtitle()</span></button> }
                        else
                        {
                            <div class="slot-art"><GameCover Source="@game.Cover" Alt="@game.AltText" />@if (Loadout.ChosenSlotIndex == index) { <span class="slot-state slot-state--chosen">✓ Chosen tonight</span> } else if (Recommendation.RecommendedIndex == index) { <span class="slot-state">Recommended</span> }</div>
                            <div class="slot-content"><h4>@game.Title</h4><p>@game.Purpose</p><dl class="slot-metrics"><div><dt>@game.PrimaryLabel</dt><dd>@game.PrimaryValue</dd></div><div><dt>@game.SecondaryLabel</dt><dd>@game.SecondaryValue</dd></div></dl><div class="slot-actions"><button class="text-button" @onclick="() => Open(DialogKind.Progress, index)">Update progress <span aria-hidden="true">↗</span></button><details class="game-menu"><summary aria-label="More actions for @game.Title">•••</summary><div><button @onclick="() => Open(DialogKind.Complete, index)">Mark completed</button><button @onclick="() => Open(DialogKind.Drop, index)">Drop game</button></div></details></div></div>
                        }
                    </article>
                }
            </div></section>
            <details class="slot-explanation"><summary>How slots work <span aria-hidden="true">+</span></summary><p>Keep up to three games active. When you're ready to move on, mark a game completed or deliberately drop it. Either action opens that slot for your next game. Completed games earn 500 XP; dropped games stay in your history without a penalty.</p></details>
        }
        <footer class="app-footer"><span>Play a little. Finish something.</span><span>Temporary midterm data · resets when the app restarts</span></footer>
    </main>
    @if (dialog != DialogKind.None)
    {
        <LoadoutDialog Title="@DialogTitle" Eyebrow="@(dialog == DialogKind.Profile ? "Your progress" : SelectedRole.ToDisplayName())" OnClose="Close">
            <ChildContent>
                @if (modalError != null) { <p class="form-error" role="alert">@modalError</p> }
                @if (dialog == DialogKind.Add)
                {
                    <p class="dialog-description">@SelectedRole.ToSubtitle() Add a game you want to keep coming back to.</p>
                    <EditForm Model="gameForm" OnValidSubmit="SaveGame" id="add-game-form" class="game-form">
                        <DataAnnotationsValidator />
                        <div class="field"><label for="game-title">Game title</label><InputText id="game-title" @bind-Value="gameForm.Title" placeholder="What are you playing?" maxlength="100" autofocus /><ValidationMessage For="() => gameForm.Title" /></div>
                        <div class="preset-list" aria-label="Example games for this slot">
                            @foreach (var preset in SampleGames.ForRole(SelectedRole))
                            {
                                <button class="sample-preset" type="button" @onclick="() => ApplySample(preset)"><GameCover Source="@preset.Cover" Alt="@preset.AltText" /><span><small>Or try this sample</small><b>@preset.Title</b></span><span aria-hidden="true">↗</span></button>
                            }
                        </div>
                        <div class="form-columns"><div class="field"><label for="game-minutes">Typical session (minutes)</label><InputNumber id="game-minutes" @bind-Value="gameForm.Minutes" min="15" max="240" /><ValidationMessage For="() => gameForm.Minutes" /></div><div class="field"><label for="game-energy">Energy needed</label><InputSelect id="game-energy" @bind-Value="gameForm.Energy"><option value="25">Low · a quick break</option><option value="50">Steady · another round</option><option value="65">Focused · a story session</option></InputSelect></div></div>
                        <details class="optional-fields"><summary>Cover image <span>Optional</span></summary><div class="field"><label for="game-cover">Image URL</label><InputText id="game-cover" @bind-Value="gameForm.CoverUrl" placeholder="https://…" maxlength="1000" /><label for="game-upload">Or upload an image</label><InputFile id="game-upload" OnChange="UploadCover" accept="image/png,image/jpeg,image/webp,image/gif" /><small>PNG, JPG, WebP or GIF. Maximum 5 MB.</small>@if (uploadedCover != null) { <p class="notice">Image ready.</p> }</div></details>
                        <details class="optional-fields"><summary>Starting progress <span>Optional</span></summary><div class="field"><label for="game-purpose">A note about this game</label><InputText id="game-purpose" @bind-Value="gameForm.Purpose" maxlength="180" /><label for="game-primary">@SelectedRole.DefaultPrimaryLabel()</label><InputText id="game-primary" @bind-Value="gameForm.Primary" maxlength="100" /><label for="game-secondary">@SelectedRole.DefaultSecondaryLabel()</label><InputText id="game-secondary" @bind-Value="gameForm.Secondary" maxlength="100" /></div></details>
                    </EditForm>
                }
                else if (dialog == DialogKind.Progress)
                {
                    <p class="dialog-description">A small update makes it easier to pick up next time.</p><form id="progress-form" class="game-form" @onsubmit="SaveProgress" @onsubmit:preventDefault><div class="field"><label for="progress-primary">@SelectedGame?.PrimaryLabel</label><input id="progress-primary" @bind="progressPrimary" maxlength="100" required autofocus /></div><div class="field"><label for="progress-secondary">@SelectedGame?.SecondaryLabel</label><input id="progress-secondary" @bind="progressSecondary" maxlength="100" required /></div></form>
                }
                else if (dialog is DialogKind.Complete or DialogKind.Drop)
                {
                    <div class="confirm-game"><GameCover Source="@SelectedGame?.Cover" Alt="@(SelectedGame?.AltText ?? "Game cover")" /><div><strong>@SelectedGame?.Title</strong><p>@(dialog == DialogKind.Complete ? "Move to Completed · +500 XP" : "Move to Dropped · no XP penalty")</p></div></div>
                    <p class="dialog-description">@(dialog == DialogKind.Complete ? "Finished this one? Record it in your history and open this slot for your next game." : "It's okay to move on. This game and your reason will stay in History, and the slot will open immediately.")</p>
                    <div class="field"><label for="outcome-note">@(dialog == DialogKind.Complete ? "A note to remember it by" : "Why are you moving on?") <span class="muted">(optional)</span></label><textarea id="outcome-note" @bind="outcomeNote" maxlength="500" placeholder="Leave a note for your future self…"></textarea></div>
                }
                else if (dialog == DialogKind.Profile)
                {
                    <div class="profile-intro"><span class="avatar avatar--large">@Initial</span><div><h3>@Auth.CurrentUser.DisplayName</h3><p>@(Auth.Account.IsDemo ? "Sample demo account" : Auth.CurrentUser.Email)</p></div></div>
                    <div class="xp-heading"><strong>Level @Auth.CurrentUser.Level</strong><span>@Auth.CurrentUser.CurrentXp / @Auth.CurrentUser.XpToNextLevel XP</span></div><progress class="xp-progress" max="@Auth.CurrentUser.XpToNextLevel" value="@Auth.CurrentUser.CurrentXp" aria-label="Progress to next level"></progress><p class="help">Earn 500 XP each time you complete a game.</p>
                    <div class="profile-totals"><div><strong>@Auth.CurrentUser.ClearedCount</strong><span>Completed</span></div><div><strong>@Auth.CurrentUser.DroppedCount</strong><span>Dropped</span></div></div>
                    <h3 class="badges-heading">Your badges</h3>@if (!Auth.CurrentUser.Badges.Any()) { <p class="muted">Your first completion earns your first badge.</p> } else { @foreach (var badge in Auth.CurrentUser.Badges) { <div class="badge-row"><span aria-hidden="true">@badge.Icon</span><div><strong>@badge.Name</strong><p>@badge.Description</p></div></div> } }
                }
            </ChildContent>
            <Footer>
                <button type="button" class="button button--quiet" @onclick="Close">@(dialog == DialogKind.Profile ? "Close" : "Cancel")</button>
                @if (dialog == DialogKind.Add) { <button class="button" type="submit" form="add-game-form" disabled="@uploading">@(uploading ? "Reading image…" : "Add to loadout")</button> }
                else if (dialog == DialogKind.Progress) { <button class="button" type="submit" form="progress-form">Save progress</button> }
                else if (dialog == DialogKind.Complete) { <button class="button" @onclick="Complete">Mark completed</button> }
                else if (dialog == DialogKind.Drop) { <button class="button" @onclick="Drop">Drop game</button> }
            </Footer>
        </LoadoutDialog>
    }
</div>
}
else if (ready) { <RedirectToLogin /> }

@code {
    [SupplyParameterFromQuery(Name="view")] public string? View { get; set; }
    private bool IsHistory => View == "history";
    private bool ready, uploading, interactive;
    private string? feedback, modalError, uploadedCover;
    private string historyFilter = "All", progressPrimary = "", progressSecondary = "", outcomeNote = "";
    private enum DialogKind { None, Add, Progress, Complete, Drop, Profile }
    private DialogKind dialog;
    private int selectedIndex;
    private Guid? selectedGameId;
    private GameFormModel gameForm = new();
    private IReadOnlyList<GameItem?> Slots => Loadout.Slots;
    private int ActiveCount => Slots.Count(g => g != null);
    private string Initial => Auth.CurrentUser.DisplayName[..1].ToUpperInvariant();
    private SlotType SelectedRole => (SlotType)(selectedIndex + 1);
    private GameItem? SelectedGame => Slots[selectedIndex];
    private RouletteResult Recommendation => Loadout.EvaluateTonight(Loadout.TimeAvailable, Loadout.BrainBattery);
    private GameItem? ChosenGame => Loadout.ChosenSlotIndex is int i ? Slots[i] : null;
    private IEnumerable<GameItem> AllHistory => Loadout.HallOfFame.Concat(Loadout.Graveyard).OrderByDescending(g => g.DateCompleted);
    private IEnumerable<GameItem> History => AllHistory.Where(g => historyFilter == "All" || (historyFilter == "Completed" ? g.Status == GameStatus.Cleared : g.Status == GameStatus.Dropped));
    private int HistoryCount(string filter) => AllHistory.Count(g => filter == "All" || (filter == "Completed" ? g.Status == GameStatus.Cleared : g.Status == GameStatus.Dropped));
    private string DialogTitle => dialog switch { DialogKind.Add => "Add a game", DialogKind.Progress => "Update progress", DialogKind.Complete => "Another game, finished.", DialogKind.Drop => "Ready to move on?", _ => "Your player profile" };
    protected override async Task OnInitializedAsync() { await Auth.InitializeAsync(); ready = true; Loadout.OnLoadoutChanged += Refresh; }
    protected override void OnAfterRender(bool firstRender) { if (firstRender) { interactive = true; StateHasChanged(); } }
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Loadout.OnLoadoutChanged -= Refresh;
    protected override void OnParametersSet() { dialog = DialogKind.None; feedback = null; historyFilter = "All"; }
    private void Choose(int index) => Run(() => { Loadout.ChooseRecommendation(index); feedback = "Chosen for tonight. Enjoy your game."; });
    private void Open(DialogKind kind, int index = 0)
    {
        if (!Auth.IsAuthenticated) { Navigation.NavigateTo("/login", true); return; }
        dialog = kind; selectedIndex = index; selectedGameId = SelectedGame?.Id; modalError = null; outcomeNote = ""; uploadedCover = null; uploading = false;
        if (kind == DialogKind.Add) gameForm = new() { Minutes = index == 0 ? 90 : index == 1 ? 30 : 60, Energy = index == 0 ? 65 : index == 1 ? 25 : 50, Primary = index == 0 ? "0% complete" : index == 1 ? "30 minutes" : "Not set yet", Secondary = index == 0 ? "0 hours" : "0" };
        if (kind == DialogKind.Progress) { progressPrimary = SelectedGame?.PrimaryValue ?? ""; progressSecondary = SelectedGame?.SecondaryValue ?? ""; }
    }
    private void Close() { dialog = DialogKind.None; modalError = null; }
    private void ApplySample(GameItem s) { gameForm = new() { Title=s.Title, CoverUrl=s.Cover, Purpose=s.Purpose, Minutes=s.TargetSessionMinutes, Energy=s.MinBrainBattery, Primary=s.PrimaryValue, Secondary=s.SecondaryValue }; uploadedCover = null; }
    private async Task UploadCover(InputFileChangeEventArgs e)
    {
        modalError = null; uploadedCover = null;
        var file = e.File;
        if (file.Size > 5 * 1024 * 1024) { modalError = "That image is too large. Choose one under 5 MB."; return; }
        if (file.ContentType is not ("image/jpeg" or "image/png" or "image/webp" or "image/gif")) { modalError = "Choose a PNG, JPG, WebP or GIF image."; return; }
        uploading = true;
        try {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024); using var buffer = new MemoryStream(); await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            if (!ValidImage(bytes, file.ContentType)) { modalError = "This file isn't a supported image. Choose another file."; return; }
            uploadedCover = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
        } catch (IOException) { modalError = "Couldn't read this image. Try another file."; }
        finally { uploading = false; }
    }
    private static bool ValidImage(byte[] b, string type) => b.Length >= 12 && type switch {
        "image/png" => b.AsSpan(0,8).SequenceEqual(new byte[]{137,80,78,71,13,10,26,10}),
        "image/jpeg" => b[0] == 255 && b[1] == 216 && b[2] == 255,
        "image/gif" => System.Text.Encoding.ASCII.GetString(b,0,6) is "GIF87a" or "GIF89a",
        "image/webp" => System.Text.Encoding.ASCII.GetString(b,0,4) == "RIFF" && System.Text.Encoding.ASCII.GetString(b,8,4) == "WEBP", _ => false };
    private void SaveGame() => Run(() => {
        if (uploading) return;
        var cover = uploadedCover ?? gameForm.CoverUrl.Trim();
        if (cover.Length > 0 && uploadedCover == null && !cover.StartsWith("/images/") && !(Uri.TryCreate(cover,UriKind.Absolute,out var url) && url.Scheme is "http" or "https")) { modalError = "Use an http or https image URL, or upload an image."; return; }
        var game = new GameItem(SelectedRole, gameForm.Title.Trim(), cover, gameForm.Title + " cover", string.IsNullOrWhiteSpace(gameForm.Purpose) ? SelectedRole.ToSubtitle() : gameForm.Purpose.Trim(), SelectedRole.DefaultPrimaryLabel(), gameForm.Primary, SelectedRole.DefaultSecondaryLabel(), gameForm.Secondary, gameForm.Minutes, gameForm.Energy);
        if (!Loadout.EquipGame(selectedIndex, game, out var error)) { modalError = error; return; }
        Close(); feedback = game.Title + " added to your loadout.";
    });
    private bool StillSelected() { if (SelectedGame?.Id == selectedGameId && selectedGameId != null) return true; modalError = "This slot changed in another tab. Close this dialog and try again."; return false; }
    private void SaveProgress() => Run(() => { if (!StillSelected()) return; Loadout.UpdateProgress(selectedIndex,progressPrimary,progressSecondary); Close(); feedback = "Progress saved. Ready for next time."; });
    private void Complete() => Run(() => { if (!StillSelected()) return; if (Loadout.ClearSlot(selectedIndex,outcomeNote,out var badge,out var level)) { Close(); feedback = "Game completed. +500 XP and an open slot." + (badge != null ? " Badge earned: " + badge.Name + "." : "") + (level ? " You reached a new level." : ""); } });
    private void Drop() => Run(() => { if (!StillSelected()) return; if (Loadout.DropSlot(selectedIndex,outcomeNote)) { Close(); feedback = "Game moved to History. This slot is open again."; } });
    private void Run(Action action) { try { action(); } catch(UnauthorizedAccessException) { Navigation.NavigateTo("/login",true); } }
}
