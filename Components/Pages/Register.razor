@page "/register"
@rendermode InteractiveServer
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using MidtermExam.Models
@using MidtermExam.Services
@inject NavigationManager Navigation
@inject IAuthService AuthService

<PageTitle>LOADOUT | Create an account</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet" />
</HeadContent>

<AuthShell Title="Build your three-slot loadout"
           Description="Create your profile now. You can connect Steam or another game library after setup."
           AlternatePrompt="Already have a loadout?"
           AlternateHref="/login"
           AlternateLabel="Log in">
    <EditForm Model="registerModel" OnValidSubmit="HandleRegistration" FormName="register" class="auth-form">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="background: rgba(225, 29, 72, 0.15); border: 1px solid #e11d48; color: #fca5a5; padding: 10px 14px; font-size: 13px; margin-bottom: 16px;">
                @errorMessage
            </div>
        }

        <div class="auth-form__field">
            <label for="register-name">Display name</label>
            <InputText id="register-name"
                       @bind-Value="registerModel.DisplayName"
                       autocomplete="nickname"
                       placeholder="What should we call you?" />
            <ValidationMessage For="@(() => registerModel.DisplayName)" />
        </div>

        <div class="auth-form__field">
            <label for="register-email">Email</label>
            <InputText id="register-email"
                       type="email"
                       @bind-Value="registerModel.Email"
                       autocomplete="email"
                       inputmode="email"
                       placeholder="player@example.com" />
            <ValidationMessage For="@(() => registerModel.Email)" />
        </div>

        <div class="auth-form__field">
            <label for="register-password">Password</label>
            <InputText id="register-password"
                       type="password"
                       @bind-Value="registerModel.Password"
                       autocomplete="new-password"
                       placeholder="At least 6 characters" />
            <ValidationMessage For="@(() => registerModel.Password)" />
        </div>

        <div class="auth-form__field">
            <label for="register-confirm">Confirm password</label>
            <InputText id="register-confirm"
                       type="password"
                       @bind-Value="registerModel.ConfirmPassword"
                       autocomplete="new-password"
                       placeholder="Enter the same password again" />
            <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
        </div>

        <button class="auth-form__submit" type="submit">
            <span>Create my loadout</span>
            <span aria-hidden="true">Continue →</span>
        </button>
    </EditForm>
</AuthShell>

@code {
    private readonly RegisterModel registerModel = new();
    private string? errorMessage;

    private void HandleRegistration()
    {
        errorMessage = null;
        if (AuthService.Register(registerModel, out var error))
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            errorMessage = error;
        }
    }
}

