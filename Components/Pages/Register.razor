@page "/register"
@layout EmptyLayout
<PageTitle>Create account · LOADOUT</PageTitle>
<AuthShell Title="Create your account" Description="Next, add up to three games to your active rotation." AlternatePrompt="Already have an account?" AlternateHref="/login" AlternateLabel="Log in">
    <form class="auth-form" method="post" action="/auth/register" data-enhance="false" data-password-match>
        <AntiforgeryToken />
        @if (Error == "duplicate") { <p class="form-error" role="alert">An account with this email already exists. <a href="/login">Log in instead.</a></p> }
        <div class="field"><label for="register-name">Display name</label><input id="register-name" name="DisplayName" autocomplete="nickname" placeholder="What should we call you?" value="@DisplayName" minlength="2" maxlength="30" required aria-describedby="name-error" /><span id="name-error" class="field-error">@(Error == "DisplayName" ? "Use between 2 and 30 characters." : "")</span></div>
        <div class="field"><label for="register-email">Email</label><input id="register-email" name="Email" type="email" autocomplete="email" placeholder="you@example.com" value="@Email" maxlength="254" required aria-describedby="email-error" /><span id="email-error" class="field-error">@(Error == "Email" ? "Enter a valid email address." : "")</span></div>
        <div class="field"><label for="register-password">Password</label><div class="password-wrap"><input id="register-password" name="Password" type="password" autocomplete="new-password" placeholder="Create a password" minlength="6" maxlength="128" required aria-describedby="password-hint password-error" /><button type="button" class="password-toggle" data-password-toggle="register-password" aria-label="Show password" aria-pressed="false">Show</button></div><small id="password-hint">Use 6–128 characters.</small><span id="password-error" class="field-error">@(Error == "Password" ? "Use between 6 and 128 characters." : "")</span></div>
        <div class="field"><label for="register-confirm">Confirm password</label><div class="password-wrap"><input id="register-confirm" name="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Enter your password again" maxlength="128" required aria-describedby="confirm-error" /><button type="button" class="password-toggle" data-password-toggle="register-confirm" aria-label="Show password confirmation" aria-pressed="false">Show</button></div><span id="confirm-error" class="field-error">@(Error == "ConfirmPassword" ? "Passwords do not match." : "")</span></div>
        <button class="button" type="submit" data-pending="Creating account…">Create account <span aria-hidden="true">→</span></button>
    </form>
</AuthShell>
@code {
    [SupplyParameterFromQuery(Name="error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name="email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name="name")] public string? DisplayName { get; set; }
}
