@page "/register"
@layout EmptyLayout

<PageTitle>LOADOUT | Enlist Operative</PageTitle>

<div class="min-h-screen bg-carbon text-boneWhite flex flex-col justify-between p-6 md:p-12 font-sans selection:bg-crimsonSignal selection:text-boneWhite">
    <header class="flex justify-between items-center border-b border-hairline pb-4">
        <a href="/" class="flex items-center gap-3 group">
            <span class="w-3 h-3 bg-crimsonSignal inline-block group-hover:scale-125 transition-transform"></span>
            <span class="font-bold tracking-widest text-lg">LOADOUT</span>
            <span class="text-xs tabular-mono text-zincMeta">SYS.REG_v2.4</span>
        </a>
        <a href="/login" class="text-xs tabular-mono tracking-wider text-zincMeta hover:text-boneWhite transition-colors">ALREADY REGISTERED? LOG IN</a>
    </header>

    <main class="max-w-md w-full mx-auto my-12 bg-slateSurface border border-hairline p-8 relative">
        <div class="absolute -top-3 left-4 bg-carbon px-2 text-[10px] tabular-mono text-crimsonSignal tracking-widest uppercase border border-hairline">
            ENLISTMENT PROTOCOL
        </div>

        <h1 class="text-2xl font-bold tracking-tight mb-2">Claim Your Chassis</h1>
        <p class="text-xs text-zincMeta mb-6">Initialize your local telemetry vault and purge Steam backlog decision paralysis.</p>

        <form class="space-y-4" onsubmit="event.preventDefault(); window.location.href='/dashboard';">
            <div>
                <label class="block text-[10px] tabular-mono text-zincMeta uppercase mb-1 tracking-wider">Operative Call-Sign</label>
                <input type="text" required placeholder="VANGUARD_01" class="w-full bg-slateElevated border border-hairline px-3 py-2 text-sm text-boneWhite focus:outline-none focus:border-crimsonSignal font-mono" />
            </div>
            <div>
                <label class="block text-[10px] tabular-mono text-zincMeta uppercase mb-1 tracking-wider">Steam Profile ID / URL</label>
                <input type="text" required placeholder="https://steamcommunity.com/id/..." class="w-full bg-slateElevated border border-hairline px-3 py-2 text-sm text-boneWhite focus:outline-none focus:border-crimsonSignal font-mono" />
            </div>
            <div>
                <label class="block text-[10px] tabular-mono text-zincMeta uppercase mb-1 tracking-wider">Master Password</label>
                <input type="password" required placeholder="••••••••••••" class="w-full bg-slateElevated border border-hairline px-3 py-2 text-sm text-boneWhite focus:outline-none focus:border-crimsonSignal font-mono" />
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full bg-crimsonSignal text-boneWhite font-bold text-xs uppercase tracking-widest py-3 hover:bg-rose-600 transition-colors flex items-center justify-center gap-2">
                    <span>INITIALIZE LOADOUT</span>
                    <span class="tabular-mono text-[10px]">[ENTER]</span>
                </button>
            </div>
        </form>
    </main>

    <footer class="border-t border-hairline pt-4 flex justify-between text-[11px] tabular-mono text-zincMeta">
        <span>LOADOUT CHASSIS ENGINE</span>
        <a href="/" class="hover:text-boneWhite transition-colors">RETURN TO SYSTEM TERMINAL</a>
    </footer>
</div>
