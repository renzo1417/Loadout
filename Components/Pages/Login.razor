@page "/login"
@layout EmptyLayout
<PageTitle>Log in · LOADOUT</PageTitle>
<AuthShell Title="Log in to LOADOUT" Description="Pick up your rotation and find a game for tonight." AlternatePrompt="New to LOADOUT?" AlternateHref="/register" AlternateLabel="Create account">
    <form class="auth-form" method="post" action="/auth/login" data-enhance="false">
        <AntiforgeryToken />
        @if (Error == "credentials") { <p class="form-error" role="alert">Email or password is incorrect. Try again, or create an account.</p> }
        @if (Notice == "loggedout") { <p class="notice" role="status">You're logged out.</p> }
        <div class="field">
            <label for="login-email">Email</label>
            <input id="login-email" name="Email" type="email" autocomplete="username" placeholder="you@example.com" value="@Email" required maxlength="254" aria-invalid="@(Error == "Email")" aria-describedby="login-email-error" />
            <span id="login-email-error" class="field-error">@(Error == "Email" ? "Enter a valid email address." : "")</span>
        </div>
        <div class="field">
            <label for="login-password">Password</label>
            <div class="password-wrap"><input id="login-password" name="Password" type="password" autocomplete="current-password" placeholder="Your password" required maxlength="128" aria-describedby="login-password-error" /><button type="button" class="password-toggle" data-password-toggle="login-password" aria-label="Show password" aria-pressed="false">Show</button></div>
            <span id="login-password-error" class="field-error">@(Error == "Password" ? "Enter your password." : "")</span>
        </div>
        <button class="button" type="submit" data-pending="Logging in…">Log in <span aria-hidden="true">→</span></button>
    </form>
</AuthShell>
@code {
    [SupplyParameterFromQuery(Name="error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name="email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name="notice")] public string? Notice { get; set; }
}
