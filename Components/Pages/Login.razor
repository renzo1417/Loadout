@page "/login"
@rendermode InteractiveServer
@layout EmptyLayout
@using System.ComponentModel.DataAnnotations
@using MidtermExam.Models
@using MidtermExam.Services
@inject NavigationManager Navigation
@inject IAuthService AuthService

<PageTitle>LOADOUT | Log in</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet" />
</HeadContent>

<AuthShell Title="Resume your loadout"
           Description="Return to your three active games and get one clear recommendation for tonight."
           AlternatePrompt="New to LOADOUT?"
           AlternateHref="/register"
           AlternateLabel="Create an account">
    <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="login" class="auth-form">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div style="background: rgba(225, 29, 72, 0.15); border: 1px solid #e11d48; color: #fca5a5; padding: 10px 14px; font-size: 13px; margin-bottom: 16px;">
                @errorMessage
            </div>
        }

        <div class="auth-form__field">
            <label for="login-identity">Email or call-sign</label>
            <InputText id="login-identity"
                       @bind-Value="loginModel.Identity"
                       autocomplete="username"
                       placeholder="player@example.com or GHOST-01" />
            <ValidationMessage For="@(() => loginModel.Identity)" />
        </div>

        <div class="auth-form__field">
            <label for="login-password">Password</label>
            <InputText id="login-password"
                       type="password"
                       @bind-Value="loginModel.Password"
                       autocomplete="current-password"
                       placeholder="Enter your password" />
            <ValidationMessage For="@(() => loginModel.Password)" />
        </div>

        <button class="auth-form__submit" type="submit">
            <span>Enter LOADOUT</span>
            <span aria-hidden="true">Continue →</span>
        </button>
    </EditForm>
</AuthShell>

@code {
    private readonly LoginModel loginModel = new();
    private string? errorMessage;

    private void HandleLogin()
    {
        errorMessage = null;
        if (AuthService.Login(loginModel.Identity, loginModel.Password, out var error))
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            errorMessage = error;
        }
    }
}

